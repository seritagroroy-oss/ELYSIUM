<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes

    # API → api_new.php
    RewriteRule ^api\.php$ api_new.php [L,END]

    # Racine / → dist/index.html
    RewriteRule ^$ dist/index.html [L,END]

    # Si le fichier physique existe dans dist/ → le servir (assets JS/CSS/images)
    RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
    RewriteRule ^(.*)$ dist/$1 [L,END]

    # Tout le reste → SPA React
    RewriteRule ^(.*)$ dist/index.html [L,END]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>


